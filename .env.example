# ==============================================================================
# 환경 변수 설정 템플릿 파일 (.env.example)
#
# [역할]
# 프로젝트 실행에 필요한 각종 환경 변수(DB 비밀번호, 포트, API 키 등)의 템플릿(양식)입니다.
# 보안 및 비밀번호 유출 방지를 위해 실제 데이터가 들어가는 .env 파일은 Git에 커밋되지 않습니다.
#
# [사용 방법]
# 이 파일을 복사하여 `.env` 파일을 만든 후, 필요에 따라 로컬 값(비밀번호 등)을 변경하세요.
#   - PowerShell       : Copy-Item .env.example .env
#   - Bash / Linux / Mac: cp .env.example .env
# ==============================================================================

# 이 파일을 .env로 복사한 뒤 로컬 값만 변경하세요. .env는 Git에 커밋되지 않습니다.
APP_NAME=hanium-api
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# 로컬 Docker Compose 기본값입니다. 호스트에서 앱만 실행할 때는 DB_HOST=localhost로 변경하세요.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hanium
DB_USER=hanium
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
# Docker Compose가 MySQL 관리 계정에만 사용하는 별도 로컬 비밀번호입니다.
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
DB_SSL=false

# 쉼표가 아니라 JSON 배열 형식으로 작성합니다.
# 운영에서는 실제 프론트엔드 주소만 허용하세요.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 로그인 기능 없이 `users/me` API에서 사용할 데모 사용자입니다.
# Docker 시작 시 관련 데모 데이터가 DB에 중복 없이 생성됩니다.
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@hanium.local

# OpenAI 기능을 붙일 때만 입력합니다. 키는 절대 커밋하지 마세요.
OPENAI_API_KEY=
# 실제 사용 시 비용/품질 요구사항에 맞는 모델명으로 변경하세요.
OPENAI_MODEL=gpt-4.1-mini

# 캡처 이미지를 저장할 Azure Blob Storage 설정입니다.
# 계정 이름: Azure Portal > 스토리지 계정 > 개요에서 확인합니다.
AZURE_STORAGE_ACCOUNT_NAME=CHANGE_ME_AZURE_STORAGE_ACCOUNT_NAME
# 액세스 키: Azure Portal > 스토리지 계정 > 액세스 키의 key1 또는 key2를 입력합니다.
# 실제 키는 이 예시 파일이 아니라 Git에서 제외된 .env에만 입력하세요.
AZURE_STORAGE_ACCOUNT_KEY=CHANGE_ME_AZURE_STORAGE_ACCOUNT_KEY
# 캡처 파일을 저장할 Blob 컨테이너입니다.
AZURE_STORAGE_CONTAINER_NAME=hanium
