APP_NAME=hanium-api
ENVIRONMENT=development
DEBUG=true

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=hanium
MYSQL_USER=hanium
MYSQL_PASSWORD=hanium_password
MYSQL_SSL_ENABLED=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure Portal > 스토리지 계정 > 액세스 키에서 연결 문자열을 복사해 넣습니다.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=hanium
# 스테이지 캡처 파일은 컨테이너 안의 stage_capture/ 경로에 저장합니다.
AZURE_STORAGE_STAGE_CAPTURE_PREFIX=stage_capture
